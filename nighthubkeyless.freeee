---------------------------------------------------------
-- INPUT & BUTTONS SECTION
---------------------------------------------------------
local InputFrame = Instance.new("Frame")
InputFrame.Size = UDim2.new(0, 340, 0, 48)
InputFrame.Position = UDim2.new(0.5, -170, 0, 85)
InputFrame.BackgroundColor3 = Color3.fromRGB(28, 28, 35)
InputFrame.BorderSizePixel = 0
InputFrame.Parent = MainFrame

local InputCorner = Instance.new("UICorner")
InputCorner.CornerRadius = UDim.new(0, 10)
InputCorner.Parent = InputFrame

local InputStroke = Instance.new("UIStroke")
InputStroke.Thickness = 1
InputStroke.Color = Color3.fromRGB(45, 45, 55)
InputStroke.Parent = InputFrame

local TextBox = Instance.new("TextBox")
TextBox.Size = UDim2.new(1, -20, 1, 0)
TextBox.Position = UDim2.new(0, 10, 0, 0)
TextBox.BackgroundTransparency = 1
TextBox.PlaceholderText = "Enter key here..."
TextBox.PlaceholderColor3 = Color3.fromRGB(90, 90, 100)
TextBox.Text = ""
TextBox.TextColor3 = Color3.fromRGB(255, 255, 255)
TextBox.TextSize = 13
TextBox.Font = Enum.Font.Gotham
TextBox.ClearTextOnFocus = false
TextBox.Parent = InputFrame

local CheckBtn = Instance.new("TextButton")
CheckBtn.Size = UDim2.new(0, 165, 0, 45)
CheckBtn.Position = UDim2.new(0.5, -170, 0, 148)
CheckBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
CheckBtn.Text = "CHECK KEY"
CheckBtn.TextColor3 = Color3.fromRGB(220, 220, 230)
CheckBtn.TextSize = 12
CheckBtn.Font = Enum.Font.GothamBold
CheckBtn.AutoButtonColor = false
CheckBtn.Parent = MainFrame

local CheckCorner = Instance.new("UICorner")
CheckCorner.CornerRadius = UDim.new(0, 10)
CheckCorner.Parent = CheckBtn

local CheckStroke = Instance.new("UIStroke")
CheckStroke.Thickness = 1
CheckStroke.Color = Color3.fromRGB(70, 70, 85)
CheckStroke.Parent = CheckBtn

local GetBtn = Instance.new("TextButton")
GetBtn.Size = UDim2.new(0, 165, 0, 45)
GetBtn.Position = UDim2.new(0.5, 5, 0, 148)
GetBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 32)
GetBtn.Text = "GET KEY"
GetBtn.TextColor3 = Color3.fromRGB(160, 160, 175)
GetBtn.TextSize = 12
GetBtn.Font = Enum.Font.GothamBold
GetBtn.AutoButtonColor = false
GetBtn.Parent = MainFrame

local GetCorner = Instance.new("UICorner")
GetCorner.CornerRadius = UDim.new(0, 10)
GetCorner.Parent = GetBtn

local GetStroke = Instance.new("UIStroke")
GetStroke.Thickness = 1
GetStroke.Color = Color3.fromRGB(50, 50, 60)
GetStroke.Parent = GetBtn

local StatusLabel = Instance.new("TextLabel")
StatusLabel.Size = UDim2.new(1, 0, 0, 20)
StatusLabel.Position = UDim2.new(0, 0, 0, 215)
StatusLabel.BackgroundTransparency = 1
StatusLabel.Text = ""
StatusLabel.TextColor3 = Color3.fromRGB(150, 150, 160)
StatusLabel.TextSize = 12
StatusLabel.Font = Enum.Font.Gotham
StatusLabel.Parent = MainFrame

-- Hover & Focus Effects
CheckBtn.MouseEnter:Connect(function()
    TweenService:Create(CheckBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(50, 50, 65)}):Play()
    TweenService:Create(CheckStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(120, 120, 140)}):Play()
end)
CheckBtn.MouseLeave:Connect(function()
    TweenService:Create(CheckBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(35, 35, 45)}):Play()
    TweenService:Create(CheckStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(70, 70, 85)}):Play()
end)

GetBtn.MouseEnter:Connect(function()
    TweenService:Create(GetBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 40, 52)}):Play()
    TweenService:Create(GetStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(90, 90, 105)}):Play()
end)
GetBtn.MouseLeave:Connect(function()
    TweenService:Create(GetBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(25, 25, 32)}):Play()
    TweenService:Create(GetStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(50, 50, 60)}):Play()
end)

TextBox.Focused:Connect(function()
    TweenService:Create(InputStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(100, 100, 120)}):Play()
end)
TextBox.FocusLost:Connect(function()
    TweenService:Create(InputStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(45, 45, 55)}):Play()
end)

-- GET KEY Event
GetBtn.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(KeyLink)
        StatusLabel.TextColor3 = Color3.fromRGB(120, 180, 255)
        StatusLabel.Text = "✓ Key link copied to clipboard!"
    else
        StatusLabel.TextColor3 = Color3.fromRGB(240, 180, 90)
        StatusLabel.Text = "✕ Executor does not support setclipboard."
    end
end)

-- CHECK KEY Event
CheckBtn.MouseButton1Click:Connect(function()
    if TextBox.Text == CorrectKey then
        StatusLabel.TextColor3 = Color3.fromRGB(100, 220, 130)
        StatusLabel.Text = "✓ Key correct! Loading script..."
        
        -- Lưu Key và thời gian kích hoạt vào file hệ thống (24 Giờ)
        if writefile then
            local saveData = {
                Key = CorrectKey,
                Time = os.time()
            }
            pcall(function()
                writefile(KeyFileName, HttpService:JSONEncode(saveData))
            end)
        end

        TweenService:Create(CheckBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(40, 80, 50)}):Play()
        
        task.wait(1.2)
        
        TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1}):Play()
        task.wait(0.4)
        ScreenGui:Destroy()
        
        LoadMainScript()
    else
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        StatusLabel.Text = "✕ Invalid Key! Please try again."
        
        TextBox.Text = ""
        
        local originalPos = UDim2.new(0.5, -210, 0.5, -135)
        local originalBg = Color3.fromRGB(18, 18, 22)
        local originalStroke = Color3.fromRGB(60, 60, 70)
        
        TweenService:Create(MainFrame, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(45, 15, 20)}):Play()
        TweenService:Create(MainUIStroke, TweenInfo.new(0.1), {Color = Color3.fromRGB(255, 60, 70)}):Play()
        
        task.spawn(function()
            local offsets = {8, -8, 6, -6, 4, -4, 2, -2, 0}
            for _, offset in ipairs(offsets) do
                TweenService:Create(MainFrame, TweenInfo.new(0.04, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
                    Position = originalPos + UDim2.new(0, offset, 0, 0)
                }):Play()
                task.wait(0.04)
            end
        end)
        
        task.wait(0.3)
        TweenService:Create(MainFrame, TweenInfo.new(0.3), {BackgroundColor3 = originalBg}):Play()
        TweenService:Create(MainUIStroke, TweenInfo.new(0.3), {Color = originalStroke}):Play()
    end
end)
